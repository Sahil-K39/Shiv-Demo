# Backend
APP_ENV=development
PORT=8080
DB_PATH=./shiv_shakti.db
# Production PostgreSQL connection string. If set, backend uses PostgreSQL instead of SQLite.
# Supabase project URL: https://bmyghobfovkzchhuhnss.supabase.co
# Supabase direct connection template:
# DATABASE_URL=postgresql://postgres:[YOUR-SUPABASE-DATABASE-PASSWORD]@db.bmyghobfovkzchhuhnss.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
JWT_SECRET=change-this-long-random-secret-before-production
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
# BASE_URL is accepted as an alias for FRONTEND_URL.
BASE_URL=http://localhost:3000
ASSETS_DIR=./assets
UPLOAD_DIR=./assets/uploads
UPLOAD_PUBLIC_PATH=/assets/uploads

# Supabase Storage for production admin product image uploads.
# Create a public bucket named product-images, then set these on Render.
SUPABASE_URL=https://bmyghobfovkzchhuhnss.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_STORAGE_PREFIX=admin-products

# Optional first-admin bootstrap. Set once, start backend, then remove/rotate after admin exists.
ADMIN_EMAIL=shivshaktiproject.support@gmail.com
ADMIN_PASSWORD=Govind@Shivshakti
ADMIN_NAME=Admin

# Email delivery. Resend is recommended for production on Render.
# Replace re_xxxxxxxxx with your real Resend API key in Render, never in code.
RESEND_API_KEY=
RESEND_FROM="Shiv Shakti Project <support@shivshaktiproject.com>"
RESEND_TEST_TO=shivshaktiproject.support@gmail.com

# Optional emergency override: set true only if SMTP is verified from the host.
PREFER_SMTP=false

# Optional SMTP fallback. Leave blank locally to use backend mock email logging.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=shivshaktiproject.support@gmail.com
# SMTP_USER is accepted as an alias for SMTP_USERNAME.
SMTP_USER=shivshaktiproject.support@gmail.com
SMTP_PASSWORD=
# SMTP_PASS is accepted as an alias for SMTP_PASSWORD.
SMTP_PASS=
SMTP_FROM="Shiv Shakti <shivshaktiproject.support@gmail.com>"
# Where admin/support notifications are sent. Defaults to SMTP username if blank.
SUPPORT_EMAIL=shivshaktiproject.support@gmail.com
CART_TO_EMAIL=shivshaktiproject.support@gmail.com
ORDER_TO_EMAIL=shivshaktiproject.support@gmail.com
QUOTE_TO_EMAIL=shivshaktiproject.support@gmail.com
REQUIRE_SMTP=false

# Payment safety
# Buyers submit wholesale enquiries. You manually review payment and delivery details.
PAYMENT_PROVIDER=manual_wholesale

# Optional demo endpoint used by /send-email.
ENABLE_DEMO_EMAIL=false

# Frontend
# Production browsers should use same-origin Next.js rewrites through INTERNAL_BACKEND_URL
# so customers do not depend directly on the Render hostname.
# Leave NEXT_PUBLIC_API_URL blank in Vercel production unless you explicitly need direct API calls.
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_BACKEND_URL=http://127.0.0.1:8080
NEXT_PUBLIC_IMAGE_HOSTNAME=localhost
NEXT_PUBLIC_SUPABASE_URL=https://bmyghobfovkzchhuhnss.supabase.co
NEXT_PUBLIC_SUPABASE_IMAGE_HOSTNAME=bmyghobfovkzchhuhnss.supabase.co

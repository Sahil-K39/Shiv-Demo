# Backend
APP_ENV=development
PORT=8080
DB_PATH=./shiv_shakti.db
# Production PostgreSQL connection string. If set, backend uses PostgreSQL instead of SQLite.
DATABASE_URL=
JWT_SECRET=change-this-long-random-secret-before-production
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Optional first-admin bootstrap. Set once, start backend, then remove/rotate after admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# SMTP email delivery. Leave blank locally to use backend mock email logging.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
REQUIRE_SMTP=false

# Payment safety
# Buyers submit wholesale enquiries. You manually review payment and delivery details.
PAYMENT_PROVIDER=manual_wholesale

# Optional Resend demo endpoint used by /send-email.
ENABLE_DEMO_EMAIL=false
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=
RESEND_TEST_TO=

# Frontend
# Leave blank to use Next.js rewrites through INTERNAL_BACKEND_URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_BACKEND_URL=http://127.0.0.1:8080
NEXT_PUBLIC_IMAGE_HOSTNAME=localhost
